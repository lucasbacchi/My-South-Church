{
    "firestore": {
        "rules": "firestore.rules"
    },
    "hosting": {
        "public": "public/client",
        "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "src/**", "*.config.*", "package*.json"],
        "cleanUrls": true,
        "trailingSlash": false,
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "storage": {
        "rules": "storage.rules"
    }
}
